<form asp-action="History" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text"
                   name="searchText"
                   class="form-control"
                   placeholder="Search Number1 or Number2" />
        </div>
        <div class="col-md-3">
            <select name="operation" class="form-select">
                <option value="">All Operations</option>
@*                 <option value="+">Addition (+)</option>
                <option value="-">Subtraction (-)</option>
                <option value="*">Multiplication (*)</option>
                <option value="/">Division (/)</option> *@
                <option value="+" selected="@(Context.Request.Query["operation"] == "+" ? "selected" : null)">
                    Addition (+)
                </option>
                <option value="-" selected="@(Context.Request.Query["operation"] == "-" ? "selected" : null)">
                    Subtraction (-)
                </option>
                <option value="*" selected="@(Context.Request.Query["operation"] == "*" ? "selected" : null)">
                    Multiplication (*)
                </option>
                <option value="/" selected="@(Context.Request.Query["operation"] == "/" ? "selected" : null)">
                    Division (/)
                </option>
            </select>
        </div>


        <div class="col-md-2">
            <button type="submit" class="btn btn-success">
                Search
            </button>
        </div>
    </div>
</form>
    
        @if (Model != null && Model.Count > 0)
    {
        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Number 1</th>
                    <th>Operation</th>
                    <th>Number 2</th>
                    <th>Result</th>
                    <th>Created Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var calculation in Model)
                {
                    <tr>
                        <td>@calculation.Id</td>
                        <td>@calculation.Number1</td>
                        <td>@calculation.Operation</td>
                        <td>@calculation.Number2</td>
                        <td>@calculation.Result</td>
                        <td>@calculation.CreatedDate</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@calculation.Id" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@calculation.Id"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this calculation?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <div class="alert alert-info">
            No calculation history found.
        </div>
    }




@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchText="@Context.Request.Query["searchText"]"
                       asp-route-operation="@Context.Request.Query["operation"]">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@i"
                       asp-route-searchText="@Context.Request.Query["searchText"]"
                       asp-route-operation="@Context.Request.Query["operation"]">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchText="@Context.Request.Query["searchText"]"
                       asp-route-operation="@Context.Request.Query["operation"]">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>
}

@* </div> *@